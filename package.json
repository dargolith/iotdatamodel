{
  "name": "iotdatamodel",
  "version": "9.1.1",
  "description": "Generic data model for Internet of Things",
  "license": "MIT",
  "author": "Jesper Ahlberg",
  "homepage": "https://github.com/dargolith/iotdatamodel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dargolith/iotdatamodel.git"
  },
  "bugs": {
    "url": "https://github.com/dargolith/iotdatamodel/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./entities/*.json": "./src/entities/*.json",
    "./associations/*.json": "./src/associations/*.json",
    "./package.json": "./package.json"
  },
  "main": "src/index.js",
  "module": "src/index.js",
  "files": [
    "/CHANGELOG.md",
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "verify": "npm test",
    "preversion": "npm run verify",
    "version": "node versionexport.js && git add src/index.js",
    "prepublishOnly": "npm run verify"
  },
  "sideEffects": false,
  "keywords": [
    "datamodel",
    "iot",
    "json",
    "schema"
  ],
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "vitest": "^5.1.1"
  }
}
